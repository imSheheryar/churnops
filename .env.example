# Copy to .env and adjust. Every value is optional: the platform runs with defaults.

# --- Data -------------------------------------------------------------------
CHURNOPS_DATA_URL=https://raw.githubusercontent.com/IBM/telco-customer-churn-on-icp4d/master/data/Telco-Customer-Churn.csv
CHURNOPS_RANDOM_STATE=42

# --- Promotion gates --------------------------------------------------------
CHURNOPS_MIN_PR_AUC=0.60
CHURNOPS_MIN_RECALL=0.65
CHURNOPS_MAX_BRIER_SCORE=0.20

# --- Business costs used by the cost-sensitive threshold --------------------
CHURNOPS_COST_FALSE_NEGATIVE=1200
CHURNOPS_COST_FALSE_POSITIVE=50

# --- Drift thresholds -------------------------------------------------------
CHURNOPS_PSI_WARN=0.10
CHURNOPS_PSI_ALERT=0.20
CHURNOPS_DRIFT_SHARE_ALERT=0.30

# --- Registry and serving ---------------------------------------------------
CHURNOPS_MODEL_NAME=churnops-churn-classifier
CHURNOPS_PRODUCTION_STAGE=Production
# Leave empty to use the local SQLite tracking store (artifacts/mlflow.db)
CHURNOPS_MLFLOW_TRACKING_URI=
# Optional Slack incoming webhook for drift alerts
CHURNOPS_SLACK_WEBHOOK_URL=
CHURNOPS_LOG_LEVEL=INFO

# --- Deployment helpers -----------------------------------------------------
# Hugging Face token with write access, used by scripts/deploy_hf_space.py
HF_TOKEN=
HF_SPACE_ID=your-username/churnops
